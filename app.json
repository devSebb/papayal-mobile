{
  "expo": {
    "scheme": "papayal",
    "name": "Papayal",
    "slug": "papayal-mobile",
    "version": "1.0.1",
    "updates": {
      "url": "https://u.expo.dev/089f71cd-3c34-4cdd-ae21-fae443cec5e0"
    },
    "runtimeVersion": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/Papayal-icon.png",
    "splash": {
      "image": "./assets/Papayal-logoTag.png",
      "resizeMode": "contain",
      "backgroundColor": "#FDF1E1"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "bundleIdentifier": "com.papayal.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Papayal no usa el micrófono. Este permiso lo requiere una librería del sistema."
      },
      "entitlements": {
        "aps-environment": "production"
      },
      "associatedDomains": [
        "applinks:papayal.app"
      ],
      "appleTeamId": "DLFL9SP5JG",
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.papayal.app",
      "versionCode": 1,
      "icon": "./assets/Papayal-icon.png",
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "papayal.app",
              "pathPrefix": "/claim"
            },
            {
              "scheme": "https",
              "host": "papayal.app",
              "pathPrefix": "/reset"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.READ_CONTACTS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/Papayal-icon.png",
        "backgroundColor": "#0D2F32"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/Papayal-icon.png"
    },
    "plugins": [
      "expo-font",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "La app necesita acceso a tus fotos para cambiar tu foto de perfil.",
          "cameraPermission": "La app necesita acceso a la cámara para tomar una foto de perfil."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Papayal usa tus contactos solo para elegir a quién enviarle una tarjeta de regalo. No los almacenamos ni compartimos."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/Papayal-icon.png",
          "color": "#FCA50F"
        }
      ],
      "expo-web-browser",
      [
        "@sentry/react-native",
        {
          "url": "https://sentry.io/",
          "organization": "papayal",
          "project": "papayal-mobile"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "089f71cd-3c34-4cdd-ae21-fae443cec5e0"
      }
    }
  }
}
