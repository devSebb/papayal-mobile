{
  "expo": {
    "scheme": "papayal",
    "name": "papayal-mobile",
    "slug": "papayal-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Papayal-icon.png",
    "splash": {
      "image": "./assets/Papayal-logoTag.png",
      "resizeMode": "contain",
      "backgroundColor": "#FDF1E1"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.papayal.app",
      "deploymentTarget": "15.1",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "DLFL9SP5JG",
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": ["E174.1"]
          }
        ]
      }
    },
    "android": {
      "package": "com.papayal.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/Papayal-logoTag.png",
        "backgroundColor": "#FDF1E1"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/Papayal-logoTag.png"
    },
    "plugins": [
      "expo-font",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "La app necesita acceso a tus fotos para cambiar tu foto de perfil.",
          "cameraPermission": "La app necesita acceso a la cámara para tomar una foto de perfil."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/Papayal-icon.png",
          "color": "#FCA50F"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "089f71cd-3c34-4cdd-ae21-fae443cec5e0"
      }
    }
  }
}
